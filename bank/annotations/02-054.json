{
 "bank": "02",
 "sections": {
  "RipVanFishMain": {
   "name": "Rip Van Fish main routine",
   "summary": [
    "Sprite 0x37. Draws the fish, skips logic while sprites are locked, handles Mario contact and object collision, then runs the state routine.",
    "While Mario has a star the speeds are negated just for the position update (probably so the fish swims away); the real speeds are restored after.",
    "Outside water ([$164A] = 0) the fish gets Y speed $10 and sinks. States: 0 = asleep, 1 = chasing Mario."
   ]
  },
  "RipVanFishPtrs": {
   "name": "Pointer table: Rip Van Fish states",
   "summary": [
    "Index [RAM_SpriteState]: 0 = sleeping, 1 = chasing Mario."
   ]
  },
  "s02C132": {
   "name": "Data: Diggin Chuck phase durations"
  },
  "s02C13A": {
   "name": "Diggin Chuck: dig and throw rocks",
   "summary": [
    "Chuck state 4 (sprite 0x46 only). Cycles through 4 digging phases, timed by DATA_02C132; every 4th cycle pauses for $40 frames, otherwise throws a rock.",
    "[$1534] = phase counter, [$1540] = phase timer, [$1558] = rock throw pause, [$151C] = head frame, [$1602] = body frame."
   ]
  },
  "s02C194": {
   "name": "Data: rock spawn offsets and speeds"
  },
  "s02C19A": {
   "name": "Spawn Diggin Chuck rock",
   "summary": [
    "Spawns sprite 0x48 (Diggin Chuck rock) in front of the Chuck, thrown up and forward.",
    "Returns: nothing; returns without effect if there is no free sprite slot."
   ]
  },
  "s02C1F3": {
   "name": "Data: head frame by direction"
  },
  "ChucksMain": {
   "name": "Chuck main routine",
   "summary": [
    "Shared by all Chuck sprites (0x46, 0x91-0x95, 0x97-0x99). Sets the data bank to $02, runs the main code and arms the [$163E] timer when [$187B] changes from 0 to non-zero.",
    "[$187B] appears to be the charging flag (Chargin Chuck sets it when it starts running at Mario); [$163E] is probably a charge-start timer."
   ]
  },
  "s02C213": {
   "name": "Data: dying Chuck head frames"
  },
  "s02C217": {
   "name": "Chuck not alive: animate and draw",
   "summary": [
    "Used when the status is not 8 (stunned, killed by star, etc.): cycles the head frame with [RAM_FrameCounterB] and draws."
   ]
  },
  "s02C228": {
   "name": "Data: Chuck gravity limits"
  },
  "s02C22C": {
   "name": "Chuck: physics and state dispatch",
   "summary": [
    "Main per-frame code for a living Chuck: pose overrides, drawing, Mario/sprite interaction, wall and block collisions (a charging Chuck shatters turn blocks),",
    "gravity with water and air limits, then runs the Chuck state routine through ChuckPtrs.",
    "If the status is not 8 it jumps to the dying code at $02C217."
   ]
  },
  "ChuckPtrs": {
   "name": "Pointer table: Chuck states",
   "summary": [
    "Indexed by [RAM_SpriteState]. Names are inferred from the code and are tentative.",
    "Followed by the code of state 0B: body frame 3, and when in water with Mario within $30 pixels vertically switches to state 0C; then faces Mario."
   ]
  },
  "s02C373": {
   "name": "Data: Whistlin Chuck head frames"
  },
  "s02C37B": {
   "name": "Chuck state 0C: Whistlin Chuck",
   "summary": [
    "Plays sound $1E every $40 frames, animates body and head, and sets [$18FD] = 9 (which wakes Rip Van Fish) and, when bit 4 of sprite X is set, sprite generator number [RAM_GeneratorNum] = 9."
   ]
  },
  "s02C3B3": {
   "name": "Data: Pitchin Chuck tables"
  },
  "s02C3CB": {
   "name": "Chuck state 0A: Pitchin Chuck",
   "summary": [
    "Two modes selected by [$1534]. Mode 0: if Mario is above ($0E in $D0..$FF) the Chuck jumps ([$1540] = $3E, [$1534] = 1); otherwise winds up and throws baseballs",
    "with CODE_02C466. Mode 1: ascent and descent animation, throwing at the top of the jump. Timers: [$1540] animation/throw, [$1558] throw cooldown."
   ]
  },
  "BaseballTileDispX": {
   "name": "Data: baseball spawn offsets"
  },
  "BaseballSpeed": {
   "name": "Spawn baseball extended sprite",
   "summary": [
    "Spawns extended sprite 0x0D (baseball) beside the Pitchin Chuck, thrown in its facing direction. BaseballSpeed: +$18 / -$18.",
    "Returns: nothing; returns early if [$1558] is non-zero, the Chuck is off-screen vertically, or no free extended sprite slot."
   ]
  },
  "s02C4B5": {
   "name": "Data: Clappin Chuck frames"
  },
  "s02C4BD": {
   "name": "Chuck states 09, 08, 06, 07 and helpers",
   "summary": [
    "Counter = (8 * X + [$13]) & $7F, so each Chuck is out of phase. At 0 it faces Mario and calls CODE_03CBB3 (probably the clap effect); below $20 it plays DATA_02C4B5 body frames.",
    "$02C4BD state 09 (Clappin Chuck): counter = (8 * X + [$13]) & $7F so each Chuck is out of phase. At 0 it faces Mario and calls CODE_03CBB3 (probably the clap effect); below $20 it plays DATA_02C4B5 frames.",
    "$02C4E3 state 08 (hopping): hops towards Mario with sounds $19/$08. $02C53C state 06: land, stop, then state 07. $02C556: face Mario, set head frame. $02C564 state 07: wait, then state 05. $02C579: clear X and Y speed."
   ]
  },
  "s02C57E": {
   "name": "Data: Splittin Chuck clone speeds"
  }
 },
