{
 "bank": "01",
 "sections": {
  "s01D23F": {
   "name": "Koopa Kid boss: landing, stomp, fireballs",
   "summary": [
    "Part of the Koopa Kid boss (Ludwig/Iggy/Larry) code. $01D23F: wait timer, then turn toward Mario and fall under gravity",
    "until the floor check at CODE_01D0C0 reports a landing (ground shake, Mario locked, thud sound).",
    "$01D2A8: Mario contact. On the ground Mario is hurt; in the air a stomp from above tilts the platform ([$38]/[$39]) and stuns the boss (state 3).",
    "$01D3B1: Mario fireballs (extended sprite 5, slots $0A-$08) puff into smoke; the 12th hit defeats the boss (CODE_01CFD0).",
    "$01D40B: builds the boss hitbox in [$04]-[$07],[$0A],[$0B]. Names inferred; not fully traced."
   ]
  },
  "s01D439": {
   "name": "Table: boss fireball OAM indexes"
  },
  "s01D43E": {
   "name": "Unused. Erase sprite"
  },
  "s01D442": {
   "name": "Table: boss fireball X offsets"
  },
  "LudwigFireTiles": {
   "name": "Table: boss fireball tiles and properties"
  },
  "BossFireball": {
   "name": "Boss fireball main routine",
   "summary": [
    "Sprite 34. Moves horizontally, damages Mario, erases itself when far off-screen, and draws one or two 16x16 tiles",
    "(one tile while the spawn timer [$1540] is >= 8). Y-flip alternates every two frames.",
    "While [$1540] is non-zero (spawn delay) it neither moves nor hurts."
   ]
  },
  "s01D4E7": {
   "name": "Table: parachute sway data",
   "summary": [
    "Sway direction steps, turn-around limits and X acceleration by sway index."
   ]
  },
  "ParachuteSprites": {
   "name": "Para-Goomba and Para-Bomb main",
   "summary": [
    "Sprites 3F and 40. Descends 1 pixel every other frame while swaying left/right (X acceleration from DATA_01D4EB, applied",
    "temporarily). Touching a wall stops the sway; hitting the ground starts a $20 frame landing timer, after which the",
    "sprite turns into a normal Goomba or Bob-omb (table at $01D5AE) with timer $80. Also does that if status is not 8.",
    "The canopy and the enemy are drawn at different offsets (code at $01D5B3)."
   ]
  },
  "s01D55E": {
   "name": "Table: parachute canopy frames"
  },
  "s01D56E": {
   "name": "Table: parachute canopy direction"
  },
  "s01D57E": {
   "name": "Table: parachute enemy X offsets"
  },
  "s01D58E": {
   "name": "Table: parachute enemy X offsets, high"
  },
  "s01D59E": {
   "name": "Table: parachute enemy Y offsets"
  },
  "s01D5AE": {
   "name": "Tables: parachute enemy sprite and tile"
  },
  "s01D5B3": {
   "name": "Parachute sprites: draw and physics",
   "summary": [
    "Draws the canopy (palette 3, frame $0C/$0D) then the carried enemy at a swaying offset, runs sprite interaction,",
    "and handles the landing countdown and ground/wall checks. Position is saved on the stack and restored at the end."
   ]
  },
  "InitLineRope": {
   "name": "Init: line-guided rope mechanism",
   "summary": [
    "Sprite 64. Slot >= 6 with [$1692] set bumps the tweaker byte, then shares the line init at CODE_01D6E0."
   ]
  },
  "InitLinePlat": {
   "name": "Init: line-guided platform",
   "summary": [
    "Sprite 63. Frame from X bit 4 ($10 or 0); shares the line init at CODE_01D6E0 (timer++, two line steps, [$1626]++)."
   ]
  },
  "InitLineGuidedSpr": {
   "name": "Init: line-guided chainsaw/grinder/fuzzy",
   "summary": [
    "Sprites 65-68. Sets variant flag [$187B], then moves X depending on bit 4 of X (left -$140 or right +$0F with direction 1)."
   ]
  },
  "InitLineBrwnPlat": {
   "name": "Init: line-guided brown platform",
   "summary": [
    "Sprite 62. Sets the timer [$1540] = 2."
   ]
  },
  "s01D717": {
   "name": "Table: chainsaw spark X offsets"
  },
  "LineRope+Chainsaw": {
   "name": "Line-guided rope and chainsaw main",
   "summary": [
    "Sprites 64-66. Every 8th frame spawns a smoke puff at a small offset above the sprite, then plays the grinder sound as LineGrinder."
   ]
  },
  "LineGrinder": {
   "name": "Line-guided grinder main",
   "summary": [
    "Sprite 67. Plays sound effect $04 on every 8th frame while unlocked, then runs the common line-guide code."
   ]
  },
  "LineFuzzy+Plats": {
   "name": "Line-guided fuzzy and platforms main",
   "summary": [
    "Sprites 62, 63 and 68 and tail of the others. Jumps to CODE_01D9A7 (line-guide dispatcher). CODE_01D74D: despawn off-screen, then run state routine."
   ]
  },
  "Ptrs01D762": {
   "name": "Line-guide states and step routine",
   "summary": [
    "Pointer table for sprite state: 0 = CODE_01D7F4 (find next segment), 1 = CODE_01D768 (step along it), 2 = CODE_01DB44.",
    "CODE_01D768 walks the step index [$1534] forward (or [$1570] backward when direction is non-zero) and calls CODE_01D7B0,",
    "which reads a packed byte from the line table in bank $07 (pointer [$151C]/[$1528]): high nibble = Y, low nibble = X within the tile."
   ]
  },
  "s01D7E1": {
   "name": "Table: line probe point offsets"
  }
 },
