{
 "bank": "02",
 "sections": {
  "SumosLightningMain": {
   "name": "Sumo Bro lightning main",
   "summary": [
    "Falls, then on landing starts a flame timer and spawns a row of ground flames. Draws itself with a flickering X/Y flip.",
    "Sprite uses [$1540] as the flame timer and [$1570] as the flame offset index."
   ]
  },
  "s02DF22": {
   "name": "Table: Sumo Bro flame X offsets",
   "summary": [
    "Low byte then high byte of X offsets for the five flames (-4,+12,-20,+28,-36)."
   ]
  },
  "s02DF2C": {
   "name": "Spawn Sumo Bro flame",
   "summary": [
    "Finds a free slot in the 10-entry Sumo Bro flame tables ([$1892]-[$1E3E]) or recycles one round-robin ([$191D]).",
    "Sets position from the sprite plus the offset indexed by [$1570], and starts the flame (timer [$1892] = 6)."
   ]
  },
  "VolcanoLotusMain": {
   "name": "Volcano Lotus main",
   "summary": [
    "Wrapper: sets the data bank, then draws, moves with gravity and runs the state routine."
   ]
  },
  "VolcanoLotusPtrs": {
   "name": "Volcano Lotus states",
   "summary": [
    "Pointer table indexed by [$C2]: state 0 pulsing, 1 flickering, 2 shoots fire then restarts."
   ]
  },
  "VolcanoLotusTiles": {
   "name": "Table: Volcano Lotus top tiles",
   "summary": [
    "Tile numbers for animation frames 0-2."
   ]
  },
  "VolcanoLotusGfx": {
   "name": "Draw Volcano Lotus",
   "summary": [
    "Draws the mushroom-scale stalk, then four more tiles: the flower body ($CE) and a two-tile top that depends on the frame in [$1602] and the palette flag [$151C]."
   ]
  },
  "s02E071": {
   "name": "Table: Volcano Lotus fire speeds",
   "summary": [
    "X speeds then Y speeds for the four fire balls."
   ]
  },
  "s02E079": {
   "name": "Spawn Volcano Lotus fire balls",
   "summary": [
    "Spawns four extended sprites ($0C) with speeds from the tables above. Does nothing if offscreen; stops silently if no free slot."
   ]
  },
  "JumpingPiranhaMain": {
   "name": "Jumping Piranha Plant main",
   "summary": [
    "Draws the head and stem, then runs three states: wait for Mario to be far enough, jump up, then fall; the fire-spitting variety ($50) shoots fireballs at the apex."
   ]
  },
  "JumpingPiranhaPtrs": {
   "name": "Jumping Piranha Plant states",
   "summary": [
    "Pointer table indexed by [$C2], followed by the state routines and the fireball spawner (CODE_02E1C0)."
   ]
  },
  "s02E1F9": {
   "name": "Table: Directional Coin movement",
   "summary": [
    "Speeds by direction (X then Y) and D-pad direction mapping tables."
   ]
  },
  "s02E211": {
   "name": "Table: opposite direction",
   "summary": [
    "$01,$00,$03,$02: direction index of the opposite direction."
   ]
  },
  "DirectionCoinsMain": {
   "name": "Directional Coins main",
   "summary": [
    "Moves a coin along tiles following the D-pad, turning only at tile corners and leaving Map16 coin blocks behind. Times out via [$190C] and then restores the level music."
   ]
  },
  "GasBubbleMain": {
   "name": "Gas Bubble main",
   "summary": [
    "Wrapper: sets the data bank and runs the main routine."
   ]
  },
  "s02E30B": {
   "name": "Table: Gas Bubble movement",
   "summary": [
    "X speeds by direction, Y acceleration and Y speed limits."
   ]
  },
  "s02E311": {
   "name": "Gas Bubble movement",
   "summary": [
    "Moves horizontally at a fixed speed and bobs vertically (Y speed oscillates between limits every 4 frames). Hurts Mario on contact."
   ]
  },
  "s02E352": {
   "name": "Table: Gas Bubble tile X offsets",
   "summary": [
    "16 tiles in a 4x4 layout."
   ]
  },
  "s02E362": {
   "name": "Table: Gas Bubble tile Y offsets",
   "summary": [
    "16 tiles in a 4x4 layout."
   ]
  },
  "s02E372": {
   "name": "Table: Gas Bubble tile numbers",
   "summary": [
    "16 tile numbers."
   ]
  },
  "s02E382": {
   "name": "Table: Gas Bubble tile properties",
   "summary": [
    "$3B for the top half, $BB (Y flipped) for the bottom."
   ]
  },
  "s02E392": {
   "name": "Table: Gas Bubble wobble flags",
   "summary": [
    "Bit 1: subtract wobble in X; bit 0: subtract in Y."
   ]
  },
  "s02E3A2": {
   "name": "Table: Gas Bubble wobble offsets",
   "summary": [
    "X offsets then Y offsets by animation frame."
   ]
  },
  "GasBubbleGfx": {
   "name": "Draw Gas Bubble",
   "summary": [
    "Draws 16 8x8 tiles in a 4x4 grid, with a wobble that moves tiles in or out (X and Y) depending on animation frame and per-tile flags."
   ]
  },
  "ExplodingBlkMain": {
   "name": "Exploding Block main",
   "summary": [
    "Shakes sideways. When Mario comes within range, turns into the sprite whose number is stored in [$C2] and shatters the block into pieces."
   ]
  }
 },
