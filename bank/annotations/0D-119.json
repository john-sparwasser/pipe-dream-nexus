{
 "bank": "0D",
 "sections": {
  "s0DABFD": {
   "name": "Slope object draw routines (all 8 slopes)",
   "summary": [
    "Level object draw code for the slope objects: steep/normal/gradual, left/right, plus upside-down variants.",
    "The first routine (0DABFD) writes a slope tile, adding an offset when the existing Map16 tile is $3F, $101 or $103.",
    "Each slope draws row by row into the Map16 buffer, adding slope, slope-assist and dirt/ground tiles ($03F, $165).",
    "Parameters: [$57] = start index, [$59] = size (high nibble = length/height), [$6B]/[$6E] = Map16 pointers.",
    "The upside-down routines use [$01] as an is-first-row flag."
   ]
  },
  "s0DB039": {
   "name": "Table: ledge edge top tiles"
  },
  "s0DB048": {
   "name": "Table: ledge edge tiles below the top"
  },
  "s0DB057": {
   "name": "Table: ledge edge middle tiles"
  },
  "s0DB066": {
   "name": "Table: ledge edge bottom tiles"
  },
  "s0DB075": {
   "name": "Draw ledge edge object",
   "summary": [
    "Draws a vertical column: top tile, tile below the top, middle tiles, and a bottom tile for types $0B+.",
    "Parameters: [$57] = start index, [$59]: high nibble = height, low nibble = type (0-14)."
   ]
  },
  "s0DB0F0": {
   "name": "Table: top tiles to be replaced",
   "summary": [
    "Top-tile fixup: if the existing tile is one of these, DATA_0DB102 gives the replacement."
   ]
  },
  "s0DB102": {
   "name": "Table: replacement top tiles"
  },
  "s0DB114": {
   "name": "Fix up ledge top tile over existing tile",
   "summary": [
    "Parameters: A = tile to place, X = ledge type, Y = index. Returns: A = tile to place (possibly replaced via DATA_0DB0F0/DATA_0DB102 or incremented)."
   ]
  },
  "s0DB15C": {
   "name": "Table: middle tiles to be replaced",
   "summary": [
    "Middle-tile fixup: if the existing tile is one of these, DATA_0DB17A gives the replacement."
   ]
  },
  "s0DB17A": {
   "name": "Table: replacement middle tiles"
  },
  "s0DB198": {
   "name": "Ledge middle-tile fixup and ledge objects",
   "summary": [
    "First routine fixes up the middle tile like CODE_0DB114 (via DATA_0DB15C/DATA_0DB17A).",
    "Then Long ground ledge (width = whole size byte, height 3) and Standard ledge (width = low nibble, height = high nibble): a top row of tile $100 then rows of ground tile $03F."
   ]
  },
  "s0DB212": {
   "name": "Table: midway and goal point tiles",
   "summary": [
    "Map16 tiles for the 3-tile-tall midway and goal posts, three columns per row (left, $025 middle, right)."
   ]
  }
 },
