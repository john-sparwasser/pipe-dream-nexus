{
 "bank": "04",
 "sections": {
  "s04D85D": {
   "name": "Table: event layer 1 map offsets",
   "summary": [
    "$70 words indexed by event number * 2: offset into the layer 1 map at $7E:C800 where the event's path tile lives (0 = none)."
   ]
  },
  "s04D93D": {
   "name": "Table: event second map offsets",
   "summary": [
    "$70 words indexed by event number * 2, parallel to the previous table. Values are probably offsets into the layer 1 tile buffer; purpose not verified (read by code in the next chunk)."
   ]
  },
  "s04DA1D": {
   "name": "Table: tiles replaced by events",
   "summary": [
    "22 layer 1 tile numbers that DA49 recognises; entry n is replaced by entry n of the next table."
   ]
  },
  "s04DA33": {
   "name": "Table: replacement tiles for events",
   "summary": [
    "Replacement tile for each entry of the previous table."
   ]
  },
  "s04DA49": {
   "name": "Apply completed event to layer 1 map",
   "summary": [
    "If event [$0F] is flagged complete in [$1F02+], swaps the tile at its layer 1 map offset (DATA_04D85D) for the matching DATA_04DA33 tile.",
    "If the match was table entry $15 the next tile is replaced as well. Then runs CODE_04E677 and CODE_04E9F1 for the event (path/tile setup), with [$1B86] = 0.",
    "Parameters: [$0F]: event number. $04DAAD: long wrapper (PHP/PLP) around CODE_04DC6A, called from bank $00."
   ]
  },
  "s04DAB3": {
   "name": "Table: DMA setup for layer 2 tilemap",
   "summary": [
    "7 bytes copied to $4310-$4316: DMAP $01, B-bus $18, source $7F:4000, size $2000 (source high byte becomes $60 for submaps other than 0)."
   ]
  },
  "s04DABA": {
   "name": "Decompress interleaved map; submap switch entry",
   "summary": [
    "$04DABA: RLE decompressor writing every other byte of $7F:4000+X. Header byte: bit 7 clear = copy (n+1) literal bytes, set = repeat next byte (n AND $7F)+1 times.",
    "Parameters: [$00]-[$02]: source pointer, Y: source offset, X: first dest offset, [$0E]: stop when X >= this.",
    "$04DAEF: overworld submap switch state machine entry, dispatches on [$1DE8]."
   ]
  },
  "Ptrs04DAF8": {
   "name": "Submap switch states and iris effect",
   "summary": [
    "Pointers by [$1DE8]: 0 and 6 = iris window close/open (CODE_04DB18), 1-4 = redraw layer 1 pages (CODE_04DCB6), 5 = load tileset (CODE_04DB9D), 7 = finish (CODE_04DBCF).",
    "DB18: moves a box-shaped window ([$1B8D]/[$1B8F] steps, limits from the tables at DB08-DB14), fills the HDMA table at $0598/$04EE with its left/right edges, sets window masks [$41]/[$43], enables HDMA ch 7.",
    "When the close finishes, CODE_049A93 switches the player's submap. DB9D: sets Mario Start tileset [$1931] for the new submap and reloads graphics."
   ]
  },
  "s04DBC8": {
   "name": "Table: music per submap",
   "summary": [
    "One music number per submap, written to [$1DFB]."
   ]
  },
  "s04DBCF": {
   "name": "Submap switch: finish and change music",
   "summary": [
    "Resets [$1DE8] to 0, sets overworld process [$13D9] = 4. Starts the new submap's music unless two players share the same submap and the music is already playing."
   ]
  },
  "s04DC02": {
   "name": "Table: Mario Start tileset per submap",
   "summary": [
    "Value stored in [$1931] for each submap (tileset $11-$17)."
   ]
  },
  "s04DC09": {
   "name": "Load all layers of overworld map",
   "summary": [
    "Long routine (JSL) used when the overworld or Mario Start is loaded. Selects the tileset for the current player's submap, clears the $7F:C800 attribute tables, builds the pointer table at $0FBE, copies the layer 1 map from $0C:F7DF to $7E:C800, indexes event tiles (CODE_04D7F2).",
    "$04DC6A: loads layer 2: decompresses the layer 2 tile data and then applies every completed event to it."
   ]
  },
  "s04DCAE": {
   "name": "Table: bit masks 80 to 01",
   "summary": [
    "Bit masks for event flags. Probably an unused duplicate of DATA_04E44B."
   ]
  },
  "s04DCB6": {
   "name": "Draw layer 1 map page to tilemap buffer",
   "summary": [
    "Submap switch states 1-4. Expands 256 map16 tiles of the layer 1 map into 8x8 tiles in the tilemap buffer $7E:E400. Page = [$1DE8] - 1 (plus 4 if the player's submap is not 0).",
    "$04DD40/$04DD57: RLE decompressor used to unpack the layer 2 attribute data from $0C:8D00 to $7F:0000 (header bit 7 set = repeat; ends at a $FFFF word)."
   ]
  },
  "s04DD8D": {
   "name": "Table: layer 2 block copies for events",
   "summary": [
    "4-byte records: source offset (into $0C:8000 tile numbers and $7F:0000 attributes), destination offset into the $7F:4000 layer 2 tilemap. Selected per event via DATA_04E359. A source offset >= $0900 means a 2x2 block, otherwise 6x6."
   ]
  },
  "s04E359": {
   "name": "Table: first block copy index per event",
   "summary": [
    "Word per event: index of its first record in the previous table. The next event's entry is the end index (see CODE_04E453)."
   ]
  },
  "s04E44B": {
   "name": "Table: bit masks 80 to 01",
   "summary": [
    "Bit masks for testing event flags in [$1F02+]."
   ]
  },
  "s04E453": {
   "name": "Apply completed event to layer 2 map",
   "summary": [
    "If event [$0F] is complete, runs every block copy record for it (DATA_04DD8D) via CODE_04E496.",
    "E496: reads one record and copies the block with E4D0 (2x2) or E520 (6x6), alternating tile byte from $0C:8000+Y and attribute byte from $7F:0000+Y into $7F:4000+X. The 32-tile row wrap is handled by AND #$3F tests."
   ]
  }
 },
