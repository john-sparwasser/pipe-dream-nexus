{
 "bank": "0C",
 "sections": {
  "s0CE684": {
   "name": "Credits background tilemap, RLE (not in scene table)",
   "summary": [
    "RLE stream of 864 Map16 tile low bytes, terminated by $FFFF. Control byte: bit 7 set = repeat next byte ([n]&$7F)+1 times;",
    "bit 7 clear = copy the next [n]+1 literal bytes. Decoded by CODE_0C944C into $7EB900.",
    "Not referenced by the scene pointer table DATA_0C93C1, so probably an unused or alternate scene."
   ]
  },
  "s0CE7C0": {
   "name": "Credits background tilemap 1, RLE",
   "summary": [
    "Scene 1 of the credits background pointer table DATA_0C93C1: 864 Map16 tile low bytes in the $00 page (pointer < $E8FE).",
    "Format: bit 7 set = repeat next byte ([n]&$7F)+1 times, else [n]+1 literal bytes; ends with $FFFF.",
    "Quirk: the stream actually expands to 865 bytes (last literal overruns by one); harmless."
   ]
  },
  "s0CE8EE": {
   "name": "Blank credits tilemap, RLE (all tile $00)",
   "summary": [
    "Sixteen bytes: 6 x (128 x $00), 97 x $00, $FFFF end. Not referenced by DATA_0C93C1; probably an unused blank scene."
   ]
  },
  "s0CE8FE": {
   "name": "Credits background tilemap, RLE (not in scene table)",
   "summary": [
    "RLE stream of 864 Map16 tile low bytes (same format as above). Not referenced by DATA_0C93C1, probably unused.",
    "Streams at or above $E8FE would get Map16 high byte 1 from the loader at CODE_0C93DD."
   ]
  },
  "s0CEC82": {
   "name": "Credits background tilemap 2, RLE",
   "summary": [
    "Scene 2 of the credits background pointer table DATA_0C93C1: 864 Map16 tile low bytes, RLE as above.",
    "Pointer >= $E8FE, so the loader fills the high-byte plane $7EBD00/$7EBF00 with 1 (tiles $100+)."
   ]
  },
  "s0CEF80": {
   "name": "Credits background tilemap, RLE (not in scene table)",
   "summary": [
    "RLE stream of 864 Map16 tile low bytes, same format. Not referenced by DATA_0C93C1, probably unused."
   ]
  },
  "s0CF175": {
   "name": "Credits background tilemap, RLE (not in scene table)",
   "summary": [
    "RLE stream of 864 Map16 tile low bytes, same format. Not referenced by DATA_0C93C1, probably unused."
   ]
  },
  "s0CF45A": {
   "name": "Credits tilemap 0 and overworld layer-1 tilemap",
   "summary": [
    "$F45A-$F7DE: scene 0 of DATA_0C93C1, an RLE Map16 stream (864 tiles, high byte 1 since pointer >= $E8FE).",
    "$F7DF-$FFDE: $800-byte overworld layer-1 tile map; bank 04 (CODE_04DC5A) copies it with MVN to $7EC800.",
    "Remainder to $FFFF is $FF padding."
   ]
  }
 },
