 "lines": {
  "05C40C": "A = [$1403] (layer 3 motion mode)",
  "05C40F": "Mode 0: layer 3 scrolls horizontally",
  "05C411": "Other modes: go to $05C494",
  "05C414": "A 16-bit",
  "05C416": "\\",
  "05C419": "|",
  "05C41B": "|",
  "05C41D": "} Tileset [$1931] = 1 or 3? Yes: fall to $05C421, no: go to $05C428",
  "05C41F": "/",
  "05C421": "\\",
  "05C423": "} BG3 X scroll [$22] = layer 1 X [$1A] / 2 (half-speed parallax)",
  "05C424": "/",
  "05C426": "Skip to the end (BG3 Y [$24] is left alone)",
  "05C428": "\\",
  "05C42B": "/ Sprites locked: freeze BG3 X, just copy Y (go to $05C48D)",
  "05C42D": "\\",
  "05C430": "} Y = [$1460] (direction: 1 = positive)",
  "05C433": "/",
  "05C434": "\\",
  "05C437": "|",
  "05C43A": "|",
  "05C43B": "|",
  "05C43C": "} A = [$05CBEB] * 16 = target BG3 speed ($0040)",
  "05C43D": "/",
  "05C43E": "\\",
  "05C440": "/ Direction 1: keep the positive target",
  "05C442": "\\",
  "05C445": "/ Otherwise negate the target speed (probably never executed)",
  "05C446": "Y = 0: acceleration step +4",
  "05C448": "\\",
  "05C44B": "|",
  "05C44D": "} Compare target with speed [$1458]: Y = 0 (speed too low), 2 (too high); equal: skip",
  "05C44F": "/",
  "05C451": "\\",
  "05C454": "|",
  "05C455": "} [$1458] += +4 or -4 (DATA_05CBBB): BG3 X speed ramps to the target",
  "05C458": "/",
  "05C45B": "\\",
  "05C45E": "|",
  "05C461": "|",
  "05C462": "} [$145C] = ([$145C] & $FF) + [$1458]: sub-pixel accumulator",
  "05C465": "/",
  "05C468": "\\",
  "05C46B": "|",
  "05C46D": "} A = [$145C] >> 8, sign-extended (whole pixels moved)",
  "05C470": "/",
  "05C471": "\\",
  "05C472": "} BG3 X [$22] += pixels moved",
  "05C474": "/",
  "05C476": "\\",
  "05C479": "|",
  "05C47C": "|",
  "05C47F": "|",
  "05C481": "} [$00] = [$17BD] sign-extended (layer 1 X movement this frame)",
  "05C484": "/",
  "05C486": "\\",
  "05C488": "|",
  "05C489": "} BG3 X [$22] += [$00]: BG3 also follows layer 1",
  "05C48B": "/",
  "05C48D": "\\",
  "05C48F": "/ BG3 Y [$24] = layer 1 Y [$1C]",
  "05C491": "A 8-bit",
  "05C493": "Return",
  "05C494": "\\",
  "05C495": "/ Mode 1 = vertical bobbing; other modes go to $05C4EC",
  "05C497": "\\",
  "05C49A": "/ Sprites locked: skip the bobbing",
  "05C49C": "Y = [$1460] (direction)",
  "05C49F": "\\",
  "05C4A1": "} Only every 4th frame ([$14] & 3 = 0) change the speed, else go to $05C4C0",
  "05C4A3": "/",
  "05C4A5": "\\",
  "05C4A8": "/ A = Y speed [$145A]; non-zero: go to $05C4AF",
