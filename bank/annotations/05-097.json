  "05C4CA": "/",
  "05C4CD": "\\",
  "05C4D0": "|",
  "05C4D1": "|",
  "05C4D2": "|",
  "05C4D3": "|",
  "05C4D4": "|",
  "05C4D5": "} [$145C] += [$145A] * 16 (sub-pixel accumulator, carry kept)",
