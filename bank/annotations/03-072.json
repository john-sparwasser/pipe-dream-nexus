{
 "bank": "03",
 "sections": {
  "s03AB64": {
   "name": "Bowser phase 9: bounce on the floor",
   "summary": [
    "Last Bowser phase ([$151C] = 9). Bowser falls with gravity (Y speed += 3) and bounces when he hits Y = $64: Y speed = $A0,",
    "X speed = +/-$10 away from or toward Mario, sound effect and a $20-frame ground shake.",
    "Phase 4 (CODE_03AB9F): Bowser rises off the top of the screen. Phase 5 (CODE_03ABBE): holds still while [$36]/[$37] counts up,",
    "then moves on to phase 6 and starts a music change. Phase 6 (CODE_03AC03): spawns Princess Peach, flies off to the upper left, changes music to $1C.",
    "CODE_03AC63 (called from phase 6): creates Peach in sprite slot 8 at Bowser X + 8, Y + $47."
   ]
  },
  "BlushTileDispY": {
   "name": "Data: heart Y offsets for Peach scene"
  },
  "BlushTiles": {
   "name": "Data: heart tiles for Peach scene"
  },
  "PrincessPeach": {
   "name": "Princess Peach main routine",
   "summary": [
    "Sprite $7C. Draws Peach (two 16x16 tiles via CODE_03AAC8), blinks at random (1 in 8 every 128 frames) and, while [$1558] is",
    "running, draws a small heart/blush tile next to Mario. Freezes both Peach and Mario X speed, then runs the state routine in PeachPtrs."
   ]
  },
  "PeachPtrs": {
   "name": "Pointer table: Peach states, state 0-1",
   "summary": [
    "8 states in [$C2]: 0 fall to ground (sparkles), 1 wait and face Mario, 2 walk together, 3 wait, 4 wait and blink, 5 ending picture, 6 fade, 7 start credits (CODE_03C796).",
    "State 0: falls to Y = $A0 and spawns sparkles every 8 frames. State 1: waits for [$1540], faces Mario. CODE_03ADCC: contact check between Peach and Mario (carry set if touching)."
   ]
  },
  "s03ADD9": {
   "name": "Data: Peach walk X speeds"
  },
  "s03ADDD": {
   "name": "Peach states 2-4: walk to Mario, wait",
   "summary": [
    "State 2: Peach and Mario walk toward each other until they touch, then both face each other and [$1540] = $60. State 3 waits, State 4 blinks and starts the blush timer."
   ]
  },
  "s03AE5B": {
   "name": "Data: ending picture step delays",
   "summary": [
    "$55 bytes: frame delay per step of the ending picture, indexed by [$1921]."
   ]
  },
  "s03AEAF": {
   "name": "Peach state 5: ending picture steps",
   "summary": [
    "Draws the ending picture (CODE_03D674) and advances one step ([$1921]) each time [$1540] expires, using DATA_03AE5B delays. After step $54 moves to state 6. CODE_03AED0: state++, [$1FEB] = $80."
   ]
  },
  "s03AED8": {
   "name": "Unused. Data, purpose unclear"
  },
  "s03AEE8": {
   "name": "Peach state 6: fade ending color",
   "summary": [
    "Writes a grey CGRAM color $F1 (value = timer/2 replicated into R, G, B) to the palette buffer each frame so the ending picture fades; redraws the picture. When [$1540] reaches 0, goes to CODE_03AED0."
   ]
  },
  "s03AF34": {
   "name": "Data: Bowser hit star offsets and tiles"
  },
  "s03AF59": {
   "name": "Draw hit stars and puffs around Bowser",
   "summary": [
    "Called while [$14B5] (hit flash timer) is non-zero. Draws 4 stars (tile $59) circling Bowser and, for the first $68 frames of [$14B3], a trail of smoke puffs (tile $49); then copies the 5 OAM entries into the extended OAM area."
   ]
  },
  "s03B013": {
   "name": "Data: Mecha-Koopa spawn offsets and speeds"
  },
  "s03B019": {
   "name": "Bowser drops two Mecha-Koopas",
   "summary": [
    "Finds a free sprite slot (0 or 1) twice and spawns Mecha-Koopa ($A2, status 8) at Bowser X + 0 / + $10, Y + $10, with X speed $F8 / $08 and Y speed $C0. Parameters: [$02] = side (0 left, 1 right)."
   ]
  },
  "s03B074": {
   "name": "Data: Mario shove X speeds"
  },
  "s03B078": {
   "name": "Bowser Mario and Mecha-Koopa contact",
   "summary": [
    "Runs when Bowser is in phase 7 or later and [$38] = $20. Checks carried Mecha-Koopas against Bowser (CODE_03B0DC/03B0F3), then three Bowser hitboxes against Mario via MarioSprInteract (Tweaker $24-$26):",
    "first two shove Mario away; the last hurts him. Mecha-Koopa hit starts the hit flash [$14B5] = $4C and kills the sprite."
   ]
  },
  "BowserBallSpeed": {
   "name": "Data: bowling ball X speeds"
  }
 },
