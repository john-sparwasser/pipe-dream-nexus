{
 "bank": "03",
 "sections": {
  "FallingSpikePtrs": {
   "name": "Falling spike: state handlers",
   "summary": [
    "State 0: stand still until Mario is within $40 pixels horizontally, then state 1 with a $40 frame timer.",
    "State 1: shake in place while [$1540] runs, then fall (gravity applied earlier in the main routine) and hurt Mario on contact."
   ]
  },
  "CrtEatBlkSpeedX": {
   "name": "Table: creating/eating block X speed"
  },
  "CrtEatBlkSpeedY": {
   "name": "Table: creating/eating block Y speed and contact map",
   "summary": [
    "Also contains DATA_039279: sprite-block contact bits (1 right, 2 left, 4 down, 8 up) to direction 0-3."
   ]
  },
  "CreateEatBlock": {
   "name": "Creating/eating block main routine",
   "summary": [
    "Moving block that follows a fixed path, either laying down blocks (creating) or erasing them (eating) behind it.",
    "Mode in [$151C]: 0 creating, non-zero eating. Path steps come from CrtEatBlkData1 (submap non-zero) or CrtEatBlkData2 (submap 0).",
    "Step byte: high nibble = blocks to travel, low 2 bits = direction, $FF = end of path (sprite removed). Eating mode follows the existing trail of blocks."
   ]
  },
  "GenTileFromSpr1": {
   "name": "Generate block at sprite position",
   "summary": [
    "Parameters: A: block number to generate. Uses sprite X/Y position."
   ]
  },
  "CrtEatBlkData1": {
   "name": "Table: creating block path (submap non-zero)",
   "summary": [
    "Step bytes: high nibble = blocks to travel, low 2 bits = direction (0 right, 1 left, 2 down, 3 up), $FF = end."
   ]
  },
  "CrtEatBlkData2": {
   "name": "Table: creating block path (submap 0)"
  },
  "WoodenSpike": {
   "name": "Wooden spike main routine",
   "summary": [
    "Sprites $AC/$AD. Draws, handles Mario contact, then cycles through 4 states (rise, pause, drop, pause)."
   ]
  },
  "WoodenSpikePtrs": {
   "name": "Pointer table: wooden spike states"
  },
  "SetTimerNextState": {
   "name": "Set timer and go to next state",
   "summary": [
    "Parameters: A: value for timer [$1540]. Increments the sprite state."
   ]
  },
  "s039484": {
   "name": "Table: wooden spike push direction"
  },
  "s039488": {
   "name": "Wooden spike Mario contact",
   "summary": [
    "Hurts Mario if he touches the center of the spike; otherwise pushes him sideways by 1 pixel and zeroes his X speed."
   ]
  },
  "WoodSpikeDispY": {
   "name": "Table: wooden spike tile Y offsets"
  },
  "WoodSpikeTiles": {
   "name": "Table: wooden spike tile numbers"
  },
  "WoodSpikeGfxProp": {
   "name": "Table: wooden spike tile properties"
  },
  "WoodSpikeGfx": {
   "name": "Wooden spike graphics: setup",
   "summary": [
    "Sprite $AD uses the second half of the tables."
   ]
  },
  "WoodSpikeGfxLoopSt": {
   "name": "Wooden spike graphics: draw 5 tiles",
   "summary": [
    "Draws 5 16x16 tiles in a column."
   ]
  },
  "RexSpeed": {
   "name": "Table: Rex X speed"
  },
  "RexMainRt": {
   "name": "Rex main routine",
   "summary": [
    "Draws Rex. Only runs while status is 8 and sprites are unlocked. Counts down the remains timer when flattened."
   ]
  },
  "RexReturn": {
   "name": "Return"
  },
  "RexAlive": {
   "name": "Rex: walk and animate",
   "summary": [
    "Animates, walks (speed depends on stomp state) and turns at walls, then interacts with sprites and Mario."
   ]
  },
  "RexNoAdjustSpeed": {
   "name": "Rex: set X speed"
  },
  "RexInAir": {
   "name": "Rex: update position"
  },
  "RexHalfSmushed": {
   "name": "Rex: wall turn and Mario contact",
   "summary": [
    "Turns at walls, then handles contact with Mario: star kills, stomp, or hurts Mario."
   ]
  },
  "MarioBeatsRex": {
   "name": "Mario stomps Rex",
   "summary": [
    "Gives points, bounces Mario. Spin jump or Yoshi kills Rex outright; first stomp half-squashes, second flattens."
   ]
  },
  "SmushRex": {
   "name": "Half squash Rex"
  },
  "RexWins": {
   "name": "Rex hurts Mario"
  },
  "NoRexContact": {
   "name": "Return"
  },
  "RexSpinKill": {
   "name": "Rex killed by spin jump"
  },
  "RexStarKill": {
   "name": "Rex killed by star"
  },
  "RexKilledSpeed": {
   "name": "Table: Rex X speed when killed"
  },
  "RexPoints": {
   "name": "Give points for stomp",
   "summary": [
    "Gives points based on the consecutive stomp counter [$1697] and plays the matching sound."
   ]
  },
  "RexTileDispX": {
   "name": "Table: Rex tile X offsets"
  },
  "RexTileDispY": {
   "name": "Table: Rex tile Y offsets"
  },
  "RexTiles": {
   "name": "Table: Rex tile numbers"
  },
  "RexGfxProp": {
   "name": "Table: Rex tile properties"
  },
  "RexGfxRt": {
   "name": "Rex graphics routine",
   "summary": [
    "Chooses frame: 5 when remains timer is set, 2 when half squashed. Draws 2 tiles (second row of tables for facing right)."
   ]
  },
  "RexGfxAlive": {
   "name": "Rex graphics: half squashed frame"
  },
  "RexNotHalfSmushed": {
   "name": "Rex graphics: draw tiles"
  },
  "RexGfxLoopStart": {
   "name": "Rex graphics: tile loop"
  },
  "RexFaceLeft": {
   "name": "Rex graphics: write tile"
  },
  "Rex8x8Tile": {
   "name": "Rex graphics: store tile size"
  },
  "Fishbone": {
   "name": "Fishbone main routine",
   "summary": [
    "Swims horizontally; sometimes opens its mouth. Alternates between accelerating and slowing down."
   ]
  },
  "FishbonePtrs": {
   "name": "Pointer table: Fishbone states"
  },
  "FishboneMaxSpeed": {
   "name": "Table: Fishbone max X speed"
  },
  "FishboneAcceler": {
   "name": "Table: Fishbone states and acceleration",
   "summary": [
    "State 0 accelerates up to max speed; state 1 slows to a stop. Each lasts $30 frames."
   ]
  },
  "FishboneDispX": {
   "name": "Table: Fishbone tail X offsets"
  },
  "FishboneDispY": {
   "name": "Table: Fishbone tail Y offsets"
  },
  "FishboneGfxProp": {
   "name": "Table: Fishbone tail properties"
  },
  "FishboneTailTiles": {
   "name": "Table: Fishbone tail tile numbers"
  },
  "FishboneGfx": {
   "name": "Fishbone graphics, and aim at Mario routine",
   "summary": [
    "Draws head tile and 2 tail tiles. Also contains CODE_0397F9 at $0397F9: computes X/Y speeds aiming at Mario.",
    "Parameters: A: speed. Returns: $00: X speed, $01: Y speed."
   ]
  },
  "ReznorInit": {
   "name": "Reznor init",
   "summary": [
    "Slot 7 sets up the Reznor room. Rotation counter [$1570] = random."
   ]
  },
  "ReznorStartPosLo": {
   "name": "Table: Reznor start positions low"
  },
  "ReznorStartPosHi": {
   "name": "Table: Reznor start positions high"
  },
  "ReboundSpeedX": {
   "name": "Table: Reznor rebound X speed"
  },
  "Reznor": {
   "name": "Reznor main routine: start"
  },
  "ReznorNotLocked": {
   "name": "Reznor: unlocked, slot 7 setup",
   "summary": [
    "Slot 7 breaks the bridge when necessary."
   ]
  }
 },
