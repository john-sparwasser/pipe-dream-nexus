{
 "bank": "03",
 "sections": {
  "DinoGfxRt": {
   "name": "Dino Rhino and Dino Torch graphics",
   "summary": [
    "Draws sprite $6E (Dino Rhino): 4 16x16 tiles from DinoRhinoTiles, X-flipped via the mirrored half of the tables when facing right.",
    "Sprite $6F (Dino Torch): head tile plus up to 5 flame segments, flame flickers by flipping every other frame.",
    "Uses [$1602] as animation frame, [$151C] as flame length. Parameters: X = sprite index."
   ]
  },
  "DinoTilesWritten": {
   "name": "Table: Dino Torch tile counts",
   "summary": [
    "Tiles written minus 1 by [$151C] flame length (4..0). Followed by an unreferenced RTS."
   ]
  },
  "Blargg": {
   "name": "Blargg main routine",
   "summary": [
    "Draws, then (unless sprites are locked) does Mario interaction, off-screen despawn and runs one of 5 states from [$C2].",
    "Parameters: X = sprite index."
   ]
  },
  "BlarggPtrs": {
   "name": "Blargg state machine",
   "summary": [
    "State 0 waits hidden in lava; 1 eyes rise; 2 eyes look around; 3 sink and leap; 4 leap and fall back.",
    "Home position is saved in [$151C]/[$1528]/[$1534]/[$1594] and restored when Blargg falls back into the lava.",
    "Sound $25 on the leap; lava splash via CODE_03A045. The pointer table is at the top."
   ]
  },
  "s039FED": {
   "name": "Table: Blargg leap X speeds"
  },
  "s039FEF": {
   "name": "Blargg leap state, splash, graphics",
   "summary": [
    "State 4: waits [$1540] frames, plays sound $25, moves with gravity, resets to state 0 after falling back (timer $40).",
    "CODE_03A038 picks frame 1 (mouth open) at the top of the leap. CODE_03A045 spawns a lava splash $0C above the sprite.",
    "CODE_03A062 draws: state 0 nothing, states 1-3 an eyes tile with priority bits cleared, state 4 the full head (CODE_03A09D)."
   ]
  },
  "s03A082": {
   "name": "Table: Blargg tile X offsets"
  },
  "s03A08C": {
   "name": "Table: Blargg tile Y offsets"
  },
  "BlarggTilemap": {
   "name": "Blargg head draw, Bowser scene init",
   "summary": [
    "BlarggTilemap: 5 tiles per frame (2 frames). CODE_03A09D draws the 5-tile head, mirrored by direction.",
    "CODE_03A0F1: init for the Bowser scene sprite (called from InitBowserScene in bank 1): places it at X $00D0, Y $FF80, state 3."
   ]
  },
  "Bnk3CallSprMain": {
   "name": "Bank 3 sprite main dispatch",
   "summary": [
    "Called with X = sprite index. Compares the sprite number with a chain of values and JSRs the matching main routine (Light switch, Ninji, Peach, Reznor, Blargg, ...).",
    "Falls through to BowserFight when nothing matches. Always restores the data bank and returns with RTL."
   ]
  },
  "BowserFight": {
   "name": "Bowser fight sprite main",
   "summary": [
    "Fallthrough target for unmatched sprite numbers: lightning/palette update, Bowser logic, item box and scene graphics."
   ]
  },
  "s03A265": {
   "name": "Table: Bowser animation values",
   "summary": [
    "[$1429] by [$38] / 8 (20 entries, probably Bowser animation)."
   ]
  },
  "s03A279": {
   "name": "Bowser main logic",
   "summary": [
    "Sets animation values [$1428]/[$1429]/[$1BA2] and Mode 7 center, runs hurt/hit timers ([$14B5], [$14B0], [$14B1]), Mario interaction, applies speed and runs state [$151C] via BowserFightPtrs.",
    "Names of $14Bx timers are inferred, not verified."
   ]
  },
  "BowserFightPtrs": {
   "name": "Pointer table: Bowser states",
   "summary": [
    "10 states indexed by [$151C]."
   ]
  },
  "s03A341": {
   "name": "Table: burst particle X offsets",
   "summary": [
    "9 phases of 8 signed offsets."
   ]
  },
  "s03A389": {
   "name": "Table: burst particle Y offsets",
   "summary": [
    "9 phases of 8 signed offsets."
   ]
  },
  "s03A3D1": {
   "name": "Table: burst particle properties and tiles",
   "summary": [
    "OAM properties for 8 particles, then tiles by phase."
   ]
  },
  "s03A3E2": {
   "name": "Draw expanding particle burst",
   "summary": [
    "Draws 8 particles using OAM slots from $70, phase from [$1564]; they move outward as the timer counts down."
   ]
  },
  "s03A437": {
   "name": "Table: Bowser state data, purpose unclear"
  }
 },
