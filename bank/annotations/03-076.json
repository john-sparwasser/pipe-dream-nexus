{
 "bank": "03",
 "sections": {
  "s03C9E9": {
   "name": "Draw firework burst particles",
   "summary": [
    "Draws one firework burst: 64 particles in the $0200 OAM area, then 20 more in the $0300 area (84 in all).",
    "Each particle position comes from a pattern table (type [$1534] 0-2 or 3+), scaled by the radius [$1570] with the hardware",
    "multiplier, so the burst expands. From animation frame 6 on, a small jitter makes the particles sparkle.",
    "Parameters: X = sprite slot; [$1570] radius, [$1602] animation frame, [$1534] firework type. Always 8x8 tiles, priority 3."
   ]
  },
  "ChuckSprGenDispX": {
   "name": "Table: football spawn X offset"
  },
  "ChuckSprGenSpeedHi": {
   "name": "Table: football spawn X high offset"
  },
  "ChuckSprGenSpeedLo": {
   "name": "Football spawn and Koopa Kid main",
   "summary": [
    "$03CBB1: football X speed table. $03CBB3: Chuck throws a football (called from bank 02): spawns sprite $1B ahead of the Chuck,",
    "moving horizontally at $18/$E8 and upward at $E0. Returns without spawning if there is no free slot.",
    "$03CC09: long-call wrapper for the Pipe Koopa Kid sprite main routine (set from bank 01). $03CC14 draws the sprite and, when",
    "status = 8 and sprites are not locked, runs the state routine for [$151C]."
   ]
  },
  "PipeKoopaPtrs": {
   "name": "Pointer table: Pipe Koopa Kid states",
   "summary": [
    "Indexed by [$151C]: 0 pick pipe and timing, 1 rise, 2 peek out (can be stomped), 3 sink, 4 stomped, 5 fall, 6 landed (ends the",
    "level). Hedge: the sprite looks like a Koopa Kid (number $29) peeking from pipes; Mario stomps it three times."
   ]
  },
  "s03CC38": {
   "name": "Data: pipe positions and rise timers"
  },
  "s03CC51": {
   "name": "Data: initial animation frames"
  },
  "s03CC5A": {
   "name": "Table: pipe number by random value",
   "summary": [
    "Indexed by [$160E] (random 0-15) | [$1570] (0, $10 or $20): gives the pipe number 0-6 for each of the three Koopa Kid sprites."
   ]
  },
  "s03CC8A": {
   "name": "Koopa Kid state 0: choose pipe",
   "summary": [
    "Waits for [$1540]. Picks (main sprite) a random seed, puts the sprite on its pipe, spawns the two helper sprites, chooses a",
    "rise timer and initial frame, and moves on to state 1."
   ]
  },
  "s03CCE0": {
   "name": "Data: helper part offsets"
  },
  "s03CCE2": {
   "name": "Spawn helper Koopa Kids; state 1 rise",
   "summary": [
    "$03CCE2: spawns two extra sprites ($29) at the same position, with [$1570] = $10 and $20 (copies [$C2], [$160E] and position).",
    "$03CD21 (state 1): rises with Y speed $F8; when [$1540] expires sets it to $40 and goes to state 2."
   ]
  },
  "s03CD37": {
   "name": "Table: Koopa Kid peek animation frames",
   "summary": [
    "Indexed by [$1528] * 16 + [$1540] / 4; gives the animation frame [$1602] while peeking out of the pipe."
   ]
  },
  "s03CDC7": {
   "name": "Koopa Kid states 2-4: peek, sink, stomped",
   "summary": [
    "State 2: checks Mario contact and animates from DATA_03CD37; when the timer ends goes to state 3.",
    "State 3: sinks at Y speed $10; helpers erase themselves, the main sprite returns to state 0.",
    "State 4 (after a stomp): flickers or plays the recoil frames; after the third stomp ([$1534] = 3) goes to state 5, otherwise sinks."
   ]
  },
  "s03CE56": {
   "name": "Data: recoil animation frames"
  },
  "s03CE5A": {
   "name": "Koopa Kid states 5-6 and Mario contact",
   "summary": [
    "State 5: falls (Y speed + 3 up to $40); on reaching Y >= $85 in the lower screen goes to state 6 with a $80 timer and impact effect.",
    "State 6: sinks at Y speed 4; when the timer ends erases the sprite, increments [$13C6], sets end-of-level timer [$1493] = $FF and music $0B.",
    "$03CEA7: Mario contact: falling stomps score points, bounce Mario and put the sprite in state 4; the second stomp of the main sprite",
    "kills the other sprites; otherwise Mario is hurt."
   ]
  },
  "s03CEF2": {
   "name": "Table: Koopa Kid X offsets",
   "summary": [
    "Used by the draw routine at $03D484: 6 tiles per frame, 23 frames, indexed by [$1602] * 6 + tile."
   ]
  },
  "s03CF7C": {
   "name": "Table: Koopa Kid X offsets (state 6)",
   "summary": [
    "Used by the draw routine at $03D484: 6 tiles per frame, 23 frames, indexed by [$1602] * 6 + tile."
   ]
  },
  "s03D006": {
   "name": "Table: Koopa Kid Y offsets",
   "summary": [
    "Used by the draw routine at $03D484: 6 tiles per frame, 23 frames, indexed by [$1602] * 6 + tile."
   ]
  },
  "s03D090": {
   "name": "Table: Koopa Kid Y offsets (state 6)",
   "summary": [
    "Used by the draw routine at $03D484: 6 tiles per frame, 23 frames, indexed by [$1602] * 6 + tile."
   ]
  },
  "s03D11A": {
   "name": "Table: Koopa Kid tile numbers",
   "summary": [
    "Used by the draw routine at $03D484: 6 tiles per frame, 23 frames, indexed by [$1602] * 6 + tile."
   ]
  },
  "s03D1A4": {
   "name": "Table: Koopa Kid tile numbers (state 6)",
   "summary": [
    "Used by the draw routine at $03D484: 6 tiles per frame, 23 frames, indexed by [$1602] * 6 + tile."
   ]
  },
  "LemmyGfxProp": {
   "name": "Table: Koopa Kid OAM properties",
   "summary": [
    "Used by the draw routine at $03D484 (ORed with $10): 6 tiles per frame, 23 frames. The next table is WendyGfxProp (state 6)."
   ]
  }
