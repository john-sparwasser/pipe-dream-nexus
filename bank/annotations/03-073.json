{
 "bank": "03",
 "sections": {
  "BowserBowlingBall": {
   "name": "Bowser bowling ball main",
   "summary": [
    "Main routine of the bowling ball Bowser throws (sprite $A1): draws it, applies gravity (+3 per frame, max $40),",
    "lands on the floor line Y = $B0, plays a thud and shakes the ground on hard landings, bounces via CODE_03B7F8,",
    "and starts rolling toward Mario after the first landing. [$1570] is the rotation counter, stepped by roll direction."
   ]
  },
  "BowserBallDispX": {
   "name": "Table: bowling ball tile X offsets"
  },
  "BowserBallDispY": {
   "name": "Table: bowling ball tile Y offsets"
  },
  "BowserBallTiles": {
   "name": "Table: bowling ball tile numbers"
  },
  "BowserBallGfxProp": {
   "name": "Table: bowling ball tile properties"
  },
  "BowserBallTileSize": {
   "name": "Table: bowling ball tile sizes"
  },
  "BowserBallDispX2": {
   "name": "Table: bowling ball spin X offsets"
  },
  "BowserBallDispY2": {
   "name": "Table: bowling ball spin Y offsets"
  },
  "BowserBallGfx": {
   "name": "Bowling ball graphics routine",
   "summary": [
    "Draws 12 tiles (a 3x3 body plus 3 extra pieces) into OAM at index $70, then moves tiles 2 and 3 (the bright pieces)",
    "around a circle using the 8-step offset tables, stepped by [$1570] >> 3, to fake rotation."
   ]
  },
  "MechakoopaSpeed": {
   "name": "Table: Mechakoopa walk speed"
  },
  "MechaKoopa": {
   "name": "Mechakoopa main",
   "summary": [
    "Draws itself, then (status 8, sprites unlocked) walks at +/-8 X speed, turns toward Mario every 64 frames",
    "while on the ground, reverses at walls, and advances the walk animation frame in [$1602] (0-3).",
    "Stunned handling is elsewhere; here [$1540] only drives the stun graphics."
   ]
  },
  "MechakoopaDispX": {
   "name": "Table: Mechakoopa tile X offsets"
  },
  "MechakoopaDispY": {
   "name": "Table: Mechakoopa tile Y offsets"
  },
  "MechakoopaTiles": {
   "name": "Table: Mechakoopa tile numbers"
  },
  "MechakoopaGfxProp": {
   "name": "Table: Mechakoopa tile properties"
  },
  "MechakoopaTileSize": {
   "name": "Table: Mechakoopa tile sizes"
  },
  "MechakoopaPalette": {
   "name": "Table: Mechakoopa stun flash palettes"
  },
  "MechaKoopaGfx": {
   "name": "Mechakoopa graphics routine",
   "summary": [
    "Draws the 4-tile Mechakoopa body (frame [$1602], mirrored by direction) and then its wind-up key. While [$1540] is non-zero",
    "it shows the stunned frames 4/5 and, for the last $30 frames, flashes the palette between $0B and $05."
   ]
  },
  "MechaKeyDispX": {
   "name": "Table: Mechakoopa key X offsets"
  },
  "MechaKeyGfxProp": {
   "name": "Table: Mechakoopa key properties"
  },
  "MechaKeyTiles": {
   "name": "Table: Mechakoopa key tiles"
  },
  "MechaKoopaKeyGfx": {
   "name": "Mechakoopa key graphics",
   "summary": [
    "Draws the rotating wind-up key on its back as one 8x8 tile in the OAM slot after the body."
   ]
  },
  "BowserItemBoxPosX": {
   "name": "Table: Bowser scene item box X"
  },
  "BowserItemBoxPosY": {
   "name": "Table: Bowser scene item box Y"
  },
  "BowserItemBoxProp": {
   "name": "Table: Bowser scene item box properties"
  },
  "BowserItemBoxGfx": {
   "name": "Bowser scene: draw item box",
   "summary": [
    "Draws the reserve item box at the top of the screen as four 16x16 corner tiles ($43, flipped). Hidden when [$190D] is non-zero",
    "(it also clears [$0DC2], the reserve item).",
    "CODE_03B43C (just above) calls this and BowserSceneGfx."
   ]
  },
  "BowserRoofPosX": {
   "name": "Table: Bowser scene roof tile X"
  },
  "BowserRoofPosY": {
   "name": "Table: Bowser scene roof tile Y"
  },
  "BowserSceneGfx": {
   "name": "Bowser scene: draw floor and roof",
   "summary": [
    "Draws the Bowser fight room backdrop with sprites: a row of floor tiles at Y = $C0 and 16 roof/battlement tiles from the tables,",
    "positioned relative to the screen scroll. [$190D] (fight phase) selects which OAM area is used (stage 0: $BC/$14, otherwise $90/$50)."
   ]
  },
  "SprClippingDispX": {
   "name": "Table: sprite hitbox X offsets",
   "summary": [
    "Indexed by [$1662] & $3F."
   ]
  },
  "SprClippingWidth": {
   "name": "Table: sprite hitbox widths"
  },
  "SprClippingDispY": {
   "name": "Table: sprite hitbox Y offsets"
  },
  "SprClippingHeight": {
   "name": "Table: sprite hitbox heights"
  },
  "MairoClipDispY": {
   "name": "Table: Mario hitbox Y offsets"
  },
  "MarioClippingHeight": {
   "name": "Table: Mario hitbox heights"
  },
  "GetMarioClipping": {
   "name": "Get Mario hitbox",
   "summary": [
    "Builds Mario's hitbox in the \"B\" slot used by CheckForContact: X = Mario X + 2, width $0C, Y = Mario Y + offset, height by",
    "form (big, small/ducking, on Yoshi). Returns: $00/$08 X, $01/$09 Y (low/high), $02 width, $03 height."
   ]
  },
  "GetSpriteClippingA": {
   "name": "Get sprite hitbox into slot A",
   "summary": [
    "Builds the hitbox of sprite X from the clipping tables ([$1662] & $3F) with sign-extended offsets.",
    "Parameters: X = sprite index. Returns: $04/$0A X, $05/$0B Y (low/high), $06 width, $07 height. X and Y preserved."
   ]
  },
  "GetSpriteClippingB": {
   "name": "Get sprite hitbox into slot B",
   "summary": [
    "Same as GetSpriteClippingA but writes $00/$08 X, $01/$09 Y, $02 width, $03 height."
   ]
  },
  "CheckForContact": {
   "name": "Check two hitboxes for contact",
   "summary": [
    "Tests whether hitbox A ($04-$07, $0A-$0B) and hitbox B ($00-$03, $08-$09) overlap, on Y then X.",
    "Returns: carry set if in contact, clear otherwise. Trashes $0C and $0F."
   ]
  },
  "s03B75C": {
   "name": "Table: offscreen margins and flags"
  },
  "GetDrawInfoBnk3": {
   "name": "Get sprite draw info (bank 3)",
   "summary": [
    "Common graphics prologue. Sets [RAM_OffscreenHorz]/[RAM_OffscreenVert], sets [$15C4] if far offscreen, and gives screen-relative position.",
    "Returns: $00/$01 = sprite X/Y relative to the screen, Y = sprite OAM index. If far offscreen it pops its own return address",
    "so the calling graphics routine returns without drawing."
   ]
  },
  "s03B7D2": {
   "name": "Table: bowling ball bounce speeds"
  },
  "s03B7F8": {
   "name": "Set bounce Y speed",
   "summary": [
    "Replaces Y speed by a bounce speed from DATA_03B7D2 indexed by old speed / 4 (+$13 for sprite $A1, the bowling ball).",
    "Table entries are negative (upward); skipped if [$1588] is negative. Called by the bowling ball on landing."
   ]
  }
