  "0DD0CF": "/",
  "0DD0D1": "\\",
  "0DD0D2": "|",
  "0DD0D3": "} Y += $10: one row down (carry bumps the buffer pointer high byte)",
  "0DD0D5": "|",
  "0DD0D6": "|",
  "0DD0D8": "/",
  "0DD0DB": "\\",
  "0DD0DE": "} Page 0 / low byte $8B: lower tile of the slope = Map16 $08B",
  "0DD0E0": "/",
  "0DD0E2": "\\",
  "0DD0E3": "|",
  "0DD0E4": "} Y += $10: one row down (carry bumps the pointer)",
  "0DD0E6": "|",
  "0DD0E7": "|",
  "0DD0E9": "/",
  "0DD0EC": "\\",
  "0DD0ED": "|",
  "0DD0EE": "|",
  "0DD0F0": "|",
  "0DD0F1": "|",
  "0DD0F3": "Branch if Y did not wrap to column 0",
  "0DD0F5": "|",
  "0DD0F6": "|",
  "0DD0F7": "|",
  "0DD0F9": "|",
  "0DD0FA": "/",
  "0DD0FD": "Save the new position in [$57]",
  "0DD0FF": "\\",
