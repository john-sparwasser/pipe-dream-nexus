  "0DD08C": "/",
  "0DD08E": "\\",
  "0DD08F": "|",
  "0DD090": "} Y += $10: one row down (carry bumps the buffer pointer high byte)",
  "0DD092": "|",
  "0DD093": "|",
  "0DD095": "/",
  "0DD098": "\\",
  "0DD09B": "} Page 0 / low byte $8A: lower tile of the slope = Map16 $08A",
  "0DD09D": "/",
  "0DD09F": "\\",
  "0DD0A0": "|",
  "0DD0A1": "} Y += $0F: one row down and one column left (carry bumps the pointer)",
  "0DD0A3": "|",
  "0DD0A4": "|",
  "0DD0A6": "/",
  "0DD0A9": "\\",
  "0DD0AA": "|",
  "0DD0AC": "|",
  "0DD0AE": "|",
  "0DD0B0": "|",
  "0DD0B1": "} If the column wrapped past the left screen edge: Y += $10 and pointer back one screen",
  "0DD0B2": "|",
  "0DD0B4": "|",
  "0DD0B5": "|",
  "0DD0B7": "|",
  "0DD0BA": "/",
  "0DD0BD": "Save the new position in [$57]",
  "0DD0BF": "\\",
  "0DD0C0": "/ Next step; loop until X wraps negative",
  "0DD0C2": "Return",
  "0DD0C3": "Y = [$57]: object position in the Map16 buffer",
  "0DD0C5": "\\",
  "0DD0C7": "} X = [$59] & $0F: object size (number of steps - 1)",
  "0DD0C9": "/",
  "0DD0CA": "\\",
