 "lines": {
  "0DD07A": "Very steep left slope: ADDR_0DD080 (type 0)",
  "0DD07D": "Very steep right slope: ADDR_0DD0C3 (type 1)",
  "0DD080": "Y = [$57]: object position in the Map16 buffer",
  "0DD082": "\\",
  "0DD084": "} X = [$59] & $0F: object size (number of steps - 1)",
  "0DD086": "/",
  "0DD087": "\\",
