{
 "bank": "0D",
 "sections": {
  "PtrsLong0DD07A": {
   "name": "Very steep slope pointers; mushroom and log objects",
   "summary": [
    "Rope/mushroom-tileset object routines, each writing Map16 tiles into the level buffer at [$6B],Y.",
    "Very steep slopes (guide-line type chosen by [$59] >> 4), mushroom ledge, mushroom column, horizontal log and vertical log.",
    "Common inputs: [$57] = position (low byte of buffer offset), [$59] = size nibbles (width/height), [$6B]/[$6E] = buffer pointers."
   ]
  },
  "s0DD1CB": {
   "name": "Tables: plant and column tiles"
  },
  "s0DD1D9": {
   "name": "Object: plants on columns",
   "summary": [
    "Draws a plant (type [$59] & $0F) and, if the height nibble is non-zero, a column below it built from the 6-byte table at $0DD1D3."
   ]
  },
  "s0DD24C": {
   "name": "Table: log bridge tiles"
  },
  "s0DD24E": {
   "name": "Object: log bridge",
   "summary": [
    "Two rows: top row Map16 $0A3, bottom row Map16 $10E, each [$59] & $0F + 1 tiles wide."
   ]
  },
  "s0DD282": {
   "name": "Map16 tiles $16E-$1FF for Underground tilesets, and unused data",
   "summary": [
    "$0DD282-$0DD3FF is $FF filler. $0DD400 is the tileset-specific Map16 page used by Underground tilesets (TilesetMAP16Loc in bank 04):",
    "8 bytes per tile = 4 x (chr, prop), tile $16E at $0DD400 up to $1FF at $0DD888. Only tiles $16E-$181 are non-zero; the rest are blank.",
    "$0DD8B8-$0DD988 is unreferenced leftover tile data (the row at $0DD930 repeats the first tiles of the page)."
   ]
  },
  "s0DD990": {
   "name": "Underground object dispatcher",
   "summary": [
    "Calls the draw routine for object [$5A] in tilesets using the Underground object set (LM tileset type 3).",
    "Index = [$5A] - 1 into the pointer table at $0DD99A."
   ]
  },
  "PtrsLong0DDA54": {
   "name": "Pointer: solid dirt; lava/mud top-right edge",
   "summary": [
    "Last entry (object $39) of the Underground object table, followed by the lava/mud top-right corner edge routine (Map16 $1FE)."
   ]
  },
  "s0DDA61": {
   "name": "Table: canvas tile numbers"
  },
  "s0DDA68": {
   "name": "Object: canvas tiles 1-7",
   "summary": [
    "Writes one canvas tile Map16 $07D + ([$59] - $75) at the position."
   ]
  },
  "s0DDA7A": {
   "name": "Tables: canvas pieces 2-4"
  },
  "s0DDA80": {
   "name": "Object: bit of canvas 2-4",
   "summary": [
    "Writes a top and bottom tile of canvas piece [$59] - $7C."
   ]
  },
  "s0DDA9E": {
   "name": "Table: torpedo launcher tiles"
  },
  "s0DDAA2": {
   "name": "Object: torpedo launcher",
   "summary": [
    "Draws a 2x2 torpedo launcher from Map16 $166-$169 on page 1."
   ]
  },
  "s0DDAC4": {
   "name": "Table: right facing mud/lava tiles"
  },
  "s0DDAC8": {
   "name": "Objects: right facing mud/lava, slope dispatch",
   "summary": [
    "Right facing mud/lava: a column of [$59] >> 4 + 1 tiles. Then the mud/lava slope dispatcher on [$59] & 3 (JSL ExecutePtrLong)."
   ]
  },
  "PtrsLong0DDAFA": {
   "name": "Mud/lava slopes, mud/lava blocks, upside down ledge",
   "summary": [
    "Pointer table for the four slope types, followed by their draw routines (normal and steep, left and right), the plain",
    "mud/lava rectangle (with or without top) and the upside down ledge. Slope routines draw growing lines, using Map16 $1D2-$1D7 edges and $1FF fill."
   ]
  },
  "s0DDD26": {
   "name": "Table: solid edge tiles"
  },
  "PtrsLong0DD99A": {
   "name": "Pointer: object $01 (water, blue)",
   "summary": [
    "Pointer table (3-byte entries) indexed by object number - 1: Underground tileset object draw routines. Objects $22-$2D are unused; $2E-$33 are generic slots; all share $0DB3E3."
   ]
  },
