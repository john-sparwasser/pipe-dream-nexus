{
 "bank": "01",
 "sections": {
  "Boo+BooBlock": {
   "name": "Boo, Big Boo and Boo Block main routine",
   "summary": [
    "Shared by Boo ($37), Big Boo ($28, entering at $01F8D5 which sets [$18B6] = $20) and Boo Block ($AF).",
    "Boo state [$C2]: 0 = chasing Mario, 1 = shy (Mario is facing it). Checked every $20 frames. Chasing: every 8th frame accelerates X and Y",
    "speed toward Mario (max +/-8). Shy: stops, decelerating to 0 and shows its hands-over-face frame 3.",
    "Boo Block ($AF): turns solid (tweaker bytes patched, CODE_01B457) when slow, hurts Mario when fast. Plain Boo ends at $01FA3D."
   ]
  },
  "BooBlockTiles": {
   "name": "Table: Boo Block tiles"
  },
  "BooBlockGfxProp": {
   "name": "Boo contact and graphics tail",
   "summary": [
    "$01FA3A: Boo Block palette bits table ($0E,$02,$02). $01FA3D: plain Boo/Big Boo end: Mario contact if status 8, then draws via the bank 3 routine CODE_038398."
   ]
  },
  "s01FA4C": {
   "name": "Table: Iggy's ball X-flip by direction"
  },
  "IggyBallTiles": {
   "name": "Tables: Iggy's ball tiles, props, X speed",
   "summary": [
    "IggyBallTiles ($4A,$4C,$4A,$4C), DATA_01FA52 (props $35/$F5 for flips), DATA_01FA56 (X speed $10/$F0 by direction)."
   ]
  },
  "Iggy'sBall": {
   "name": "Iggy's ball (sprite $A7)",
   "summary": [
    "Ball thrown by Iggy/Larry. Spins through 4 frames, moves horizontally at speed $10, falls with gravity (max $40) and bounces",
    "(Y speed $F0) off the tilting platform tiles (CODE_01FF98). Hurts Mario on contact. Vanishes in smoke when its Y is $44-$4F."
   ]
  },
  "s01FAB4": {
   "name": "Unused: table of unknown data"
  },
  "KoopaKid": {
   "name": "Koopaling sprite main: dispatch by state",
   "summary": [
    "Runs the routine for the Koopaling's state [$C2] via KoopaKidPtrs."
   ]
  },
  "KoopaKidPtrs": {
   "name": "Pointer table: Koopaling behaviors, and tables",
   "summary": [
    "7 pointers by state [$C2]: 0-2 (Morton, Roy, Ludwig) wall, 3-4 (Iggy, Larry) platform, 5-6 (Lemmy, Wendy) pipe.",
    "Followed by DATA_01FAD5 (unreferenced), DATA_01FADD (stun slide speeds by tilt) and DATA_01FAE5 (walk animation frames)."
   ]
  },
  "PlatformKoopaKids": {
   "name": "Iggy/Larry: tilting-platform Koopaling",
   "summary": [
    "Handles Iggy and Larry on the tilting Mode 7 platform. Walks toward the platform center, throws balls (timer [$1564] = $28),",
    "slides down the tilt when stunned and falls off if it reaches the edge ([$160E]). Defeat timer [$163E] ends the level.",
    "Includes the Mario/fireball contact code (CODE_01FC62) and the platform position rotation (CODE_01FD50)."
   ]
  },
  "s01FD95": {
   "name": "Table: Koopaling throw animation frames",
   "summary": [
    "16 frame numbers, indexed by [$1564] / 8."
   ]
  },
  "BallPositionDispX": {
   "name": "Table: thrown ball X offset by direction"
  },
  "ThrowBall": {
   "name": "Find free sprite slot for ball",
   "summary": [
    "Searches slots 5..0 for a free slot and falls into GenerateBall. Returns if none."
   ]
  },
  "GenerateBall": {
   "name": "Spawn Iggy's ball",
   "summary": [
    "Spawns sprite $A7 in the free slot Y, in front of the kid at [$14B8]/[$14BA], with the kid's direction. Plays sound $20."
   ]
  },
  "s01FDF3": {
   "name": "Table: Koopaling tile X offsets",
   "summary": [
    "4 tiles per frame, 12 frames; $30 more bytes for x-flipped drawing."
   ]
  },
  "s01FE53": {
   "name": "Table: Koopaling tile Y offsets",
   "summary": [
    "4 tiles per frame, 12 frames."
   ]
  },
  "s01FE83": {
   "name": "Table: Koopaling tile numbers",
   "summary": [
    "4 tiles per frame, 12 frames. Values 0-4 are placeholders replaced for Iggy via DATA_01FEB3."
   ]
  },
  "s01FEB3": {
   "name": "Tables: Koopaling tile fixups, sizes, palettes",
   "summary": [
    "DATA_01FEB3 (Iggy placeholder tiles), DATA_01FEB6 (OAM size by slot), DATA_01FEB7 (palette by state)."
   ]
  },
  "s01FEBC": {
   "name": "Draw platform Koopaling",
   "summary": [
    "Draws the 4 tiles of a platform Koopaling (frame [$1602]) at its rotated position [$14B8]/[$14BA] (+$60 Y), with X flip from direction.",
    "Iggy (state 3) substitutes placeholder tiles; tiles >= $4A (ball) use palette $35."
   ]
  },
  "s01FF53": {
   "name": "Tables: flashing tile numbers and flips"
  }
 },
